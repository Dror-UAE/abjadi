{
  "name": "@abjadi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist .turbo",
    "clear-scans": "tsx scripts/clear-scans.ts",
    "clear-scans:all": "tsx scripts/clear-scans.ts -- --all"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@supabase/supabase-js": "^2.110.9",
    "hono": "^4.7.8"
  },
  "devDependencies": {
    "@abjadi/eslint-config": "workspace:*",
    "@abjadi/typescript-config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
