# iOS Simulator (API on same Mac):
EXPO_PUBLIC_API_URL=https://abjadi.fly.dev

# Physical iPhone on same Wi‑Fi (Mac LAN IP — run: ipconfig getifaddr en0):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3500

# Production builds (`eas build --profile production`) use `.env.production`.
# After editing that file, sync to EAS:
#   eas env:push production --path .env.production --force

# Android USB:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3500
# adb reverse tcp:3500 tcp:3500
