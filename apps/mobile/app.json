{
  "expo": {
    "name": "Abjadi",
    "slug": "abjadi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "abjadi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abjadi.app",
      "buildNumber": "3",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#593A23",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.abjadi.app",
      "versionCode": 4,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#593A23",
          "image": "./assets/images/splash-android.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "ios": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Abjadi to use the camera to photograph text and inscriptions.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Abjadi to access your photos so you can choose an image to analyze."
        }
      ],
      "expo-document-picker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98ce6c25-3794-4e15-ba01-f345a01cda94"
      }
    },
    "owner": "ar7ab"
  }
}
